{
  "name": "@rafa-protocol/rafa-fund",
  "version": "2.0.0",
  "private": true,
  "description": "RAFA Protocol smart contracts for non-custodial, tokenized investment funds on Base and Ethereum.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "build": "hardhat compile --build-profile production",
    "check:size": "node scripts/check-contract-size.mjs",
    "compile": "hardhat compile",
    "deploy:base-sepolia": "hardhat run scripts/deploy-base-sepolia.ts --network baseSepolia",
    "test": "hardhat test test/RafaFundV2.ts",
    "typecheck": "tsc --noEmit",
    "clean": "hardhat clean",
    "check": "npm run build && npm run check:size && npm test && npm run typecheck"
  },
  "dependencies": {
    "@openzeppelin/contracts": "5.6.1"
  },
  "overrides": {
    "serialize-javascript": "7.1.2"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox-mocha-ethers": "3.0.7",
    "@types/chai": "5.2.3",
    "@types/mocha": "10.0.10",
    "@types/node": "22.18.6",
    "chai": "6.2.2",
    "ethers": "^6.17.0",
    "hardhat": "3.17.0",
    "mocha": "^11.8.0",
    "typescript": "6.0.3"
  }
}
